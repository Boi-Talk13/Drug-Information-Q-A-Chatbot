# Copy this file to .env and put the real values in .env
# Never commit .env. It is in .gitignore.

# --- AI model (Groq) --------------------------------------------------------
# Optional. If left blank / as the placeholder, the backend uses its built-in
# extractive answerer (no key needed) and page numbers are still guaranteed.
# With a real Groq key, the LLM writes smoother prose; citations are still
# verified against the retrieved PDF text.
AI_API_KEY=put_your_key_here
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1

# --- Where the medicine PDFs and the search index live ----------------------
PDF_FOLDER=./data/pdfs
INDEX_FOLDER=./data/index

# --- Optional retrieval tuning (safe defaults if omitted) -------------------
# TOP_K=5
# MAX_CITATIONS=4
# LEXICAL_WEIGHT=0.5

# --- Database (production option) ------------------------------------------
# The demo logs answers to SQLite with zero setup. Point this at PostgreSQL
# only if you wire it up (see backend/api/logdb.py).
# DATABASE_URL=postgresql://localhost:5432/drugqa

# Database (PostgreSQL). Leave unset to use the built-in SQLite fallback.
# DATABASE_URL=postgresql://USER@localhost:5432/medcite
