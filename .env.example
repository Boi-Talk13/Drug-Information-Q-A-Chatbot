# Copy this file to .env and put the real values in .env
# Never commit .env. It is in .gitignore.

# --- AI model (Groq) --------------------------------------------------------
# Optional. If left blank / as the placeholder, the backend uses its built-in
# extractive answerer (no key needed) and page numbers are still guaranteed.
# With a real Groq key, the LLM writes smoother prose; citations are still
# verified against the retrieved PDF text.
AI_API_KEY=put_your_key_here
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1

# --- Where the medicine PDFs and the search index live ----------------------
PDF_FOLDER=./data/pdfs
INDEX_FOLDER=./data/index

# --- Optional retrieval tuning (safe defaults if omitted) -------------------
# TOP_K=5
# MAX_CITATIONS=4
# LEXICAL_WEIGHT=0.5

# --- Database (production option) ------------------------------------------
# The demo logs answers to SQLite with zero setup. Point this at PostgreSQL
# only if you wire it up (see backend/api/logdb.py).
# DATABASE_URL=postgresql://localhost:5432/drugqa

# Database (PostgreSQL). Leave unset to use the built-in SQLite fallback.
# DATABASE_URL=postgresql://USER@localhost:5432/medcite

# --- Library & upload permissions -------------------------------------------
# PDFs in data/pdfs/shared/ are the curated built-in library every user can read.
#
# Uploading is open to anyone, but ONLY for a PDF published on rxabbvie.com.
# The user must paste the official link, and the file they pick must have the
# same name as that link. Enforced in backend/sources/rxabbvie.py against a
# snapshot of the site's PDF list (backend/sources/rxabbvie_catalog.json).
# Refresh that snapshot with:  python -m backend.sources.rxabbvie --refresh
#
# ADMIN_KEY now only protects DELETING a medicine from the shared library.
ADMIN_KEY=medcite-admin

# --- Answer model budget ----------------------------------------------------
# gpt-oss is a reasoning model: too small a budget makes it return EMPTY text.
# AI_MAX_TOKENS=1600
# AI_REASONING_EFFORT=low

# --- Token budget per question --------------------------------------------
# Most PDF pieces ever sent to the AI, the fewest, and how close in score an
# extra piece must be to the best one to be sent. Fewer pieces = fewer tokens
# per question = more questions per day on Groq's free tier.
TOP_K=8
MIN_CONTEXT_PIECES=3
CONTEXT_MARGIN=0.25

# --- Per-user daily question limit ------------------------------------------
# Each user gets this many AI-written answers per day, to protect the shared
# Groq budget. Answers served from saved answers (a question someone already
# asked), greetings and refusals are free and never counted. The count resets
# at midnight in USAGE_TIMEZONE.
DAILY_QUESTION_LIMIT=30
USAGE_TIMEZONE=Asia/Kolkata
