# Copy this file to .env and put the real values in .env
# Never commit .env. It is in .gitignore.

# --- AI model (Groq) ---
# Groq writes the final answer. Get a key at https://console.groq.com
# Groq does NOT do embeddings. Those run locally, see below.
GROQ_API_KEY=put_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (run on our own server, not Groq) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Search (Chroma) ---
CHROMA_PATH=./data/index

# --- Database ---
DATABASE_URL=postgresql://drugqa:changeme@db:5432/drugqa

# --- PDFs ---
PDF_FOLDER=./data/pdfs
# When deployed on AWS, the PDFs come from this S3 bucket
S3_BUCKET=

# --- Settings ---
# Delete chats older than this many days. We store no personal data.
CHAT_RETENTION_DAYS=7
