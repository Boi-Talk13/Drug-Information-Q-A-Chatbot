# THE ONE RULE: never commit real keys.
# .env holds real values and must never be uploaded.
# Commit .env.example instead, with fake values.
.env
.env.local
*.key
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
dist/
build/

# Search index and answer log (rebuilt / recreated at runtime)
data/index/
# but keep the folder in git
!data/index/.gitkeep

# Users' uploaded PDFs are private — never commit them.
# (covers per-user subfolders, e.g. data/pdfs/user-101/*.pdf)
data/pdfs/**
!data/pdfs/.gitkeep
# ...EXCEPT the curated shared library, which ships WITH the product so every
# deployment starts with the same verified medicine PDFs.
!data/pdfs/shared/
!data/pdfs/shared/*.pdf

# OS
.DS_Store

# Evaluation scratch file (written, then swapped into tests/results/<set>.json)
tests/results/*.tmp
