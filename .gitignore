# THE ONE RULE: never commit real keys.
# .env holds real values and must never be uploaded.
# Commit .env.example instead, with fake values.
.env
.env.local
*.key
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
dist/
build/

# Search index and answer log (rebuilt / recreated at runtime)
data/index/
# but keep the folder in git
!data/index/.gitkeep

# medicine PDFs are large and fetched separately; keep the folder, not the files
data/pdfs/*.pdf
data/pdfs/*.PDF

# OS
.DS_Store
